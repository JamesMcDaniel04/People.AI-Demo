{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SampleEmails",
  "type": "object",
  "required": ["emails"],
  "properties": {
    "emails": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["thread_id", "topic", "messages"],
        "properties": {
          "thread_id": {"type": "string"},
          "topic": {"type": "string"},
          "messages": {"type": "array", "minItems": 3, "items": {"type": "object", "required": ["from", "to", "timestamp", "subject", "body"], "properties": {"from": {"type": "string"}, "to": {"type": ["string", "array"]}, "timestamp": {"type": "string"}, "subject": {"type": "string"}, "body": {"type": "string"}}}}
        }
      }
    }
  }
}

