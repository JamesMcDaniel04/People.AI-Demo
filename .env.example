# Application Environment
NODE_ENV=production

# Select data source: mcp | sample | external
DATA_SOURCE=mcp
SEED=42
ASSESSMENT_MODE=false

# MCP (Model Context Protocol) Configuration with Klavis
MCP_ENABLED=true
KLAVIS_API_KEY=your_klavis_api_key_here
MCP_USER_ID=demo-user@example.com
MCP_TIMEOUT=30000
MCP_RETRY_ATTEMPTS=3

# MCP Server Enablement (default: all enabled)
MCP_GMAIL_ENABLED=true
MCP_CALENDAR_ENABLED=true
MCP_DRIVE_ENABLED=true
MCP_SLACK_ENABLED=true
MCP_NOTION_ENABLED=true

# MCP Tool Settings
MCP_TOOL_CACHE_ENABLED=true
MCP_TOOL_CACHE_TIMEOUT=300000
MCP_MAX_CONCURRENT_TOOLS=5
MCP_TOOL_TIMEOUT=30000

# MCP Rate Limits (override defaults as needed)
MCP_RATE_LIMIT_PER_MINUTE=60
MCP_RATE_LIMIT_PER_HOUR=1000
MCP_RATE_LIMIT_PER_DAY=20000
MCP_RATE_LIMIT_MAX_CONCURRENT=1
MCP_GMAIL_RATE_LIMIT_PER_MINUTE=40
MCP_CALENDAR_RATE_LIMIT_PER_MINUTE=60
MCP_DRIVE_RATE_LIMIT_PER_MINUTE=30
MCP_SLACK_RATE_LIMIT_PER_MINUTE=50
MCP_NOTION_RATE_LIMIT_PER_MINUTE=20

# OAuth Configuration for MCP Services
MCP_OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
MCP_OAUTH_STATE_SECRET=your_secure_state_secret_here
MCP_TOKEN_STORAGE=file

# Token Refresh Behaviour
MCP_TOKEN_REFRESH_BUFFER=180

# External API Configuration (Option B: NewsAPI.org example)
EXTERNAL_API_ENABLED=false
# For NewsAPI.org set: https://newsapi.org/v2 and endpoint /everything
EXTERNAL_API_BASE_URL=https://newsapi.org/v2
EXTERNAL_API_KEY=your_newsapi_key_here

# API Endpoints
NEWS_API_ENDPOINT=/everything
FINANCIAL_API_ENDPOINT=/financial
COMPANY_API_ENDPOINT=/company

# Rate Limiting
API_RATE_LIMIT=100
API_HOURLY_LIMIT=1000

# AI Configuration - Mixed Providers (OpenAI + Anthropic)
AI_PROVIDER=mixed
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0.1
LATENCY_P95_THRESHOLD_MS=8000
LATENCY_P95_HARD_FAIL_MS=12000

# AI Model Selection (Mixed: Claude for analysis, GPT for opportunities)
AI_HEALTH_MODEL=claude-3-5-sonnet-20241022
AI_OPPORTUNITIES_MODEL=gpt-4o
AI_RISKS_MODEL=claude-3-5-sonnet-20241022
AI_RECOMMENDATIONS_MODEL=gpt-4o
AI_INSIGHTS_MODEL=claude-3-5-sonnet-20241022

# AI Features
AI_ANALYSIS_ENABLED=true
AI_RECOMMENDATIONS_ENABLED=true
AI_RISK_ASSESSMENT_ENABLED=true
AI_INSIGHTS_ENABLED=true

# Data Configuration
DATA_CACHE_ENABLED=true
DATA_CACHE_DURATION=3600000
DATA_BATCH_SIZE=100
MAX_CONCURRENT_REQUESTS=10
DATA_PIPELINE_QUALITY_THRESHOLD=0.75
DATA_PIPELINE_RECENCY_MS=30000
DATA_PIPELINE_PERSIST_TO_POSTGRES=true
DATA_PIPELINE_SOURCE_PRIORITY=klavis,sample,news,external
DATA_PIPELINE_REALTIME_ENABLED=true
DATA_PIPELINE_REALTIME_INTERVAL_MS=60000
DATA_PIPELINE_REALTIME_WARMUP_MS=5000

# Logging Configuration
LOG_LEVEL=info
LOG_CONSOLE_ENABLED=true
LOG_FILE_ENABLED=false
LOG_FILE_PATH=./logs/app.log

# Monitoring & Alerting
MONITORING_POLL_INTERVAL_MS=30000
MONITORING_DEFAULT_SLA_TARGET=0.995
PERF_LATENCY_P95_TARGET_MS=5000
PERF_LATENCY_P99_TARGET_MS=10000
PERF_ERROR_RATE_TARGET=0.01
ALERT_SLACK_WEBHOOK=
ALERT_EMAIL_RECIPIENTS=
ALERT_EMAIL_FROM=
ALERT_SUPPRESS_MINUTES=15

# Account Planning Settings
PLAN_PERIOD=Q2-Q4 2024

# Health Score Weights (must sum to 1.0)
HEALTH_WEIGHT_FINANCIAL=0.3
HEALTH_WEIGHT_ENGAGEMENT=0.3
HEALTH_WEIGHT_GROWTH=0.2
HEALTH_WEIGHT_SATISFACTION=0.2

# Opportunity Thresholds
OPPORTUNITY_THRESHOLD_HIGH=0.7
OPPORTUNITY_THRESHOLD_MEDIUM=0.4
OPPORTUNITY_THRESHOLD_LOW=0.2

# Risk Thresholds
RISK_CONTRACT_EXPIRY_DAYS=90
RISK_STAKEHOLDER_INACTIVE_DAYS=60
RISK_ENGAGEMENT_DROP=0.5

# n8n Workflow Automation Configuration
N8N_ENABLED=true
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=your_n8n_api_key_here

# n8n Execution Settings
N8N_EXECUTION_TIMEOUT=300000
N8N_RETRY_ATTEMPTS=2
N8N_RETRY_DELAY=5000

# n8n Integration Settings
N8N_KLAVIS_INTEGRATION=true
N8N_AI_INTEGRATION=true
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook

# n8n Templates
N8N_AUTO_REGISTER_TEMPLATES=true
N8N_UPDATE_EXISTING_TEMPLATES=false

# n8n Security
N8N_VALIDATE_SSL=true
N8N_ALLOWED_HOSTS=localhost,127.0.0.1
N8N_ENCRYPT_WORKFLOW_DATA=false

# Workflow Engine Configuration
WORKFLOW_ENGINE=hybrid
WORKFLOW_DEFAULT_ENGINE=internal
MAX_CONCURRENT_WORKFLOWS=5
WORKFLOW_TIMEOUT=600000

# Workflow Scheduling
WORKFLOW_SCHEDULER_ENABLED=true
WORKFLOW_TIMEZONE=UTC

# Workflow Distributors
EMAIL_DISTRIBUTOR_ENABLED=true
EMAIL_DEFAULT_TEMPLATE=account-plan
SLACK_DISTRIBUTOR_ENABLED=true
SLACK_DEFAULT_CHANNEL=#dealflow
WEBHOOK_DISTRIBUTOR_ENABLED=true
WEBHOOK_TIMEOUT=30000
SLACK_CLIENT_ID=your_slack_client_id_here
SLACK_CLIENT_SECRET=your_slack_client_secret_here
SLACK_SIGNING_SECRET=your_slack_signing_secret_here
SLACK_BOT_TOKEN=xoxb-your_slack_bot_token_here
WEBHOOK_DISTRIBUTOR_ENABLED=true

# CRM Task Settings
CRM_ENABLED=true
CRM_TYPE=salesforce
CRM_TASK_DEFAULT_OWNER_ID=
CRM_TASK_FALLBACK_OWNER_ID=
CRM_TASK_ESCALATION_OWNER_ID=
CRM_TASK_ESCALATION_ENABLED=true
CRM_TASK_ESCALATION_THRESHOLD=High
CRM_TASK_ESCALATION_NOTIFY=
CRM_TASK_OWNER_MAP={"Account Manager":"005xxxxxxxxxxxx"}
CRM_TASK_PRIORITY_MAP={"Critical":"Critical","High":"High","Medium":"Medium","Low":"Low"}
CRM_TASK_STATUS_MAP={"InProgress":"In Progress"}
CRM_TASK_DEFAULT_PRIORITY=Medium
CRM_TASK_DEFAULT_STATUS=Not Started
CRM_TASK_DEFAULT_TYPE=AI Generated Task
CRM_TASK_VERIFICATION_ENABLED=true
CRM_TASK_VERIFICATION_ATTEMPTS=1
CRM_TASK_VERIFICATION_DELAY_MS=2000
CRM_TASK_AUTO_LINK_PHASES=false
CRM_TASK_PROGRESS_TTL=604800

# Redis Configuration for Job Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Job Queue Configuration (BullMQ)
# Enable BullMQ scheduler (requires Redis)
BULLMQ_ENABLED=true
JOB_QUEUE_PREFIX=ai-account-planner
JOB_MONITORING_ENABLED=true

# Email Distribution
# Option A: Postmark (recommended for production)
#SMTP_API_KEY=your_postmark_server_token
#SMTP_FROM=noreply@yourdomain.com

# Option B: SMTP (fallback if Postmark not provided)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user_here
SMTP_PASS=your_smtp_password_here
SMTP_FROM=noreply@yourdomain.com

# Security Settings
SECURITY_RATE_LIMIT_ENABLED=true
SECURITY_CORS_ENABLED=false
SECURITY_ALLOWED_ORIGINS=localhost
SECURITY_ENCRYPTION_ENABLED=false

# Reminder System
REMINDERS_ENABLED=true
REMINDER_EVALUATION_INTERVAL_MS=60000
REMINDER_DEFAULT_SLACK_CHANNEL=#account-health
REMINDER_ESCALATION_SLACK_CHANNEL=#sales-leadership
REMINDER_SLACK_MENTIONS=@account-manager
REMINDER_ESCALATION_MENTIONS=@sales-lead
REMINDER_DEFAULT_EMAIL=account-team@example.com
REMINDER_ESCALATION_EMAIL=leadership@example.com
REMINDER_MAX_ESCALATIONS=2
REMINDER_THRESHOLD_CRITICAL=40
REMINDER_THRESHOLD_HIGH=60
REMINDER_THRESHOLD_MEDIUM=75
REMINDER_CRITICAL_DUE_MINUTES=60
REMINDER_CRITICAL_ESCALATION_MINUTES=120
REMINDER_HIGH_DUE_MINUTES=240
REMINDER_HIGH_ESCALATION_MINUTES=480
REMINDER_MEDIUM_DUE_MINUTES=1440
REMINDER_MEDIUM_ESCALATION_MINUTES=2880
REMINDER_STORAGE_PATH=data/reminders.json

# GraphRAG Configuration
GRAPHRAG_ENABLED=false
GRAPHRAG_SERVICE_URL=http://localhost:8000

# Neo4j Graph Database (Required for GraphRAG)
# For Neo4j Aura Cloud - replace with your actual connection details
NEO4J_URI=neo4j+s://30c91254.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=JGskejcz031Othy9b4qJ6LMWZEbfG1DrSsa9xmAbnDc
NEO4J_DATABASE=neo4j



# Pinecone Vector Database
PINECONE_API_KEY=pcsk_3gqJRz_7qh11tqcsnCjow6sGZUBB9LCtWsu5Kw37vPE49twU6NserhUPHsW96dm2LykHgu
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=peopleai

# GraphRAG Processing Settings
GRAPHRAG_MAX_HOPS=3
GRAPHRAG_COMMUNITY_RESOLUTION=1.0
GRAPHRAG_MIN_COMMUNITY_SIZE=3
GRAPHRAG_REASONING_DEPTH=3

# Assessment preloads (auto-create scheduled workflows on server start)
ASSESSMENT_PRELOAD=true
ASSESSMENT_ACCOUNTS=stripe,acme retail,healthtrack.io
ASSESSMENT_SLACK_CHANNEL=#account-planning
ASSESSMENT_EXEC_EMAIL=executives@company.com

# Docker Services
DOCKER_COMPOSE_ENABLED=true
NEO4J_CONTAINER_NAME=people-ai-neo4j
GRAPHRAG_CONTAINER_NAME=people-ai-graphrag
