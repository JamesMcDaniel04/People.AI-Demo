# Demo environment (no secrets). Copy to .env for a deterministic demo.
NODE_ENV=development
DATA_SOURCE=sample
ASSESSMENT_MODE=true
ASSESSMENT_PRELOAD=true
ASSESSMENT_ACCOUNTS=stripe,acme retail,healthtrack.io
ASSESSMENT_SLACK_CHANNEL=#account-planning
ASSESSMENT_EXEC_EMAIL=executives@company.com
SEED=42

# Disable external dependencies for speed unless you want to demo them
BULLMQ_ENABLED=false
GRAPHRAG_ENABLED=false
EXTERNAL_API_ENABLED=false

# LLM (optional in assessment mode; falls back gracefully)
AI_PROVIDER=mixed
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0
LATENCY_P95_THRESHOLD_MS=8000
LATENCY_P95_HARD_FAIL_MS=12000
